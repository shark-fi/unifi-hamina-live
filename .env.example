# ---------------------------------------------------------------------------
# Before you edit: blanking a true/false setting CRASHES the container.
# ---------------------------------------------------------------------------
# Emptying a text setting means "unset" and is fine — UNIFI_SITES,
# CATALYST_MODEL_OVERRIDE and CF_TUNNEL_TOKEN all ship empty on purpose.
#
# Emptying a true/false one does NOT mean false. It is unparseable, config
# validation fails, and the container exits before it binds a port:
#
#   CATALYST_ENABLED=
#   -> 1 validation error for Settings
#      catalyst_enabled: Input should be a valid boolean [input_value='']
#
# Write `false`, or delete the line and let the default apply.
#
# The rule, rather than a list: if the value shipped here is `true` or `false`,
# it must stay `true` or `false`. A list would be wrong the first time a setting
# is added — there are already two boolean debug settings not documented in this
# file.

# ---------------------------------------------------------------------------
# UniFi console connection
# ---------------------------------------------------------------------------
# Base URL of the UniFi console (UniFi OS: UDM/UDR/CloudKey Gen2, or a classic
# software controller). Include scheme, no trailing slash.
UNIFI_HOST=https://192.168.1.1

# Use a LOCAL admin account (UniFi: Admins & Users -> "Restrict to local access
# only"). A ui.com cloud account hits MFA and cannot log in from a script.
UNIFI_USERNAME=local-admin
UNIFI_PASSWORD=change-me

# Self-signed certs are the norm on local consoles; leave verification off
# unless you have a real cert. Set to true to enforce TLS verification.
UNIFI_VERIFY_TLS=false

# Restrict to specific site internal names (comma separated). Empty = all sites
# visible to the account.
UNIFI_SITES=

# How often (seconds) to poll the console for fresh live data.
POLL_INTERVAL_SECONDS=30

# Experimental: also subscribe to the controller's WebSocket event stream for
# near-instant client connect/disconnect/roam and AP up/down updates. The poll
# above stays on as the authoritative reconciler. Undocumented UniFi API.
WEBSOCKET_ENABLED=false

# Collect AP floor-plan placement (x,y) live from classic Maps / InnerSpace, so
# an AP move shows up via the API without regenerating the OpenIntent zip.
PLACEMENT_ENABLED=true

# ---------------------------------------------------------------------------
# Meraki-compatible facade
# ---------------------------------------------------------------------------
# The API key a client (e.g. a Hamina Live "Cisco Meraki" integration, or curl)
# must present in X-Cisco-Meraki-API-Key / Authorization: Bearer to read the
# Meraki-shaped endpoints. Generate a long random string.
MERAKI_COMPAT_API_KEY=replace-with-a-long-random-token

# Display name for the synthesized Meraki "organization".
MERAKI_ORG_NAME=UniFi

# ---------------------------------------------------------------------------
# Catalyst Center (DNA Center) compatible facade
# ---------------------------------------------------------------------------
# Hamina's vendor sync against this facade WORKS — APs land on a Hamina Live map
# with real channels, TX power, per-radio client counts and capacity analysis.
# The catch: the connector resolves hardware against Cisco models only, so every
# AP must declare itself Cisco via CATALYST_MODEL_OVERRIDE below. Telemetry is
# genuine; the hardware identity is not, which makes coverage simulation run on
# the wrong antenna pattern — fine for monitoring, misleading for planning.
# See docs/CATALYST.md. The individual client list is still refused.
CATALYST_ENABLED=false
CATALYST_USERNAME=hamina
CATALYST_PASSWORD=change-me
# Record every /dna/* request (matched or not) so you can see exactly what
# Hamina calls. Read it at GET /catalyst/_captured.
CATALYST_LOG_REQUESTS=true

# Force every AP to report this model string.
#
# REQUIRED for the Catalyst sync, and a deliberate trade-off. Hamina's connector
# resolves an AP against Cisco hardware only — a bare Cisco model token, make
# implied by the connector. No UniFi spelling is accepted: not UniFi's code
# (U7PROMAX), not our slug (u7-pro-max), not Hamina's display name (U7 Pro Max),
# not its own catalog id (ubiquiti:u7-pro-max). Only a Cisco token works:
#
#   CATALYST_MODEL_OVERRIDE=CW9166      # every AP reports as a Cisco 9166i
#
# Leave EMPTY unless you accept that every AP is then labelled as hardware you
# do not own, and that Hamina's coverage simulation uses its antenna pattern.
# For live UniFi data without that trade-off, use the browser extension.
CATALYST_MODEL_OVERRIDE=

# ---------------------------------------------------------------------------
# Scheduled OpenIntent refresh (near-live re-import)
# ---------------------------------------------------------------------------
# Enable the background job that re-runs the exporter on an interval.
OPENINTENT_REFRESH_ENABLED=false

# Path to the companion exporter. Baked into the image at a pinned commit, so
# the default works with nothing mounted and nothing cloned. Change it only to
# run against your own checkout (mount it over /opt/exporter, or point here).
OPENINTENT_EXPORTER_PATH=/opt/exporter/unifi_export.py

# Exporter mode and how often to regenerate the zip. Set REFRESH_SECONDS=0 to
# generate the zip once at startup (initial import) and then rely on live AP
# positions from the placement layer instead of periodic full rebuilds.
OPENINTENT_MODE=innerspace
OPENINTENT_REFRESH_SECONDS=900
OPENINTENT_OUTPUT_DIR=./exports

# When a floor plan's structure changes (rescaled, resized, image replaced, or
# a plan added/removed) the exported zip goes stale — AP *moves* do not count.
# Default: flag it on /openintent/status, log a warning, and POST the optional
# webhook below. Set AUTO_REGENERATE=true to instead re-run the exporter
# automatically on such a change.
OPENINTENT_AUTO_REGENERATE=false
OPENINTENT_STALE_WEBHOOK=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080

# Host port Docker publishes on. Change this rather than adding `ports:` to a
# compose override — an override appends to a sequence instead of replacing it,
# so you would publish both and collide with whatever already holds 8080.
HOST_PORT=8080

# ---------------------------------------------------------------------------
# Public exposure (optional) — Cloudflare Tunnel
# ---------------------------------------------------------------------------
# To reach the bridge from Hamina's cloud you need a public HTTPS endpoint.
# The `tunnel` docker compose profile runs cloudflared with this token; create
# a tunnel in the Cloudflare Zero Trust dashboard and paste its token here.
# See docs/EXPOSURE.md. Leave empty if you expose it another way.
CF_TUNNEL_TOKEN=

# --- RSSI sensors (WLAN Pi multilateration) ---------------------------------
# OFF by default. This is the ONLY endpoint that accepts data — everything else
# is read-only, and the browser extension promises exactly that. Turning it on
# opens POST /report, so it will not start without a token.
SENSORS_ENABLED=false
# Shared secret the sensors present as X-Sensor-Token. Anyone who can post here
# can put an AP anywhere on your floor plan, indistinguishably from a real
# measurement. Generate one: openssl rand -hex 24
SENSOR_TOKEN=
# Which plan the sensors cover, and where each one sits on it IN PIXELS.
# See sensors.example.json; plan_id comes from GET /api/floorplans.
SENSOR_CONFIG_PATH=./sensors.json
# Path loss. Guesses until calibrated for the site:
#   python3 rssi_sensor.py --calibrate --iface wlan1@36 --dist 5
# An uncalibrated exponent biases every distance the same way, and a
# least-squares fit absorbs that into a confident wrong position.
SENSOR_RSSI_AT_1M=-40.0
SENSOR_PATHLOSS_EXPONENT=3.0
# Samples older than this do not count toward a fix.
SENSOR_WINDOW_SECONDS=6.0
# Two circles meet at two points; three are needed to choose. Sensors are
# per-channel, so a 6 GHz radio is not heard by a 2.4 GHz interface — three
# sensors must be on the band you want to locate.
SENSOR_MIN_SENSORS=3
# Forget a transmitter unheard this long.
SENSOR_FORGET_SECONDS=300.0
