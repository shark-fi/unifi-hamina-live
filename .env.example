# ---------------------------------------------------------------------------
# Before you edit: blanking a true/false setting CRASHES the container.
# ---------------------------------------------------------------------------
# Emptying a text setting means "unset" and is fine — UNIFI_SITES,
# CATALYST_MODEL_OVERRIDE and CF_TUNNEL_TOKEN all ship empty on purpose.
#
# Emptying a true/false one does NOT mean false. It is unparseable, config
# validation fails, and the container exits before it binds a port:
#
#   CATALYST_ENABLED=
#   -> 1 validation error for Settings
#      catalyst_enabled: Input should be a valid boolean [input_value='']
#
# Write `false`, or delete the line and let the default apply.
#
# The rule, rather than a list: if the value shipped here is `true` or `false`,
# it must stay `true` or `false`. A list would be wrong the first time a setting
# is added — there are already two boolean debug settings not documented in this
# file.

# ---------------------------------------------------------------------------
# UniFi console connection
# ---------------------------------------------------------------------------
# Base URL of the UniFi console. Include the scheme AND the port; no trailing
# slash. The port is not the same on every console type:
#   UniFi OS appliance (UDM/UDR/UNVR/CloudKey Gen2)   https://192.168.1.1
#   UniFi OS Server (UniFi OS on your own Linux box)  https://10.0.0.5:11443
#   classic software controller (Java)                https://10.0.0.5:8443
# UniFi OS Server uses 11443 because 443 on a general-purpose host is usually
# taken. Getting this wrong reports as "cannot reach ... All connection attempts
# failed", which says nothing about the port. Do NOT use 8080 — that is the
# device inform port; it answers, and it is not the API.
UNIFI_HOST=https://192.168.1.1

# Use a LOCAL admin account (UniFi: Admins & Users -> "Restrict to local access
# only"). A ui.com cloud account hits MFA and cannot log in from a script.
UNIFI_USERNAME=local-admin
UNIFI_PASSWORD=change-me

# Self-signed certs are the norm on local consoles; leave verification off
# unless you have a real cert. Set to true to enforce TLS verification.
UNIFI_VERIFY_TLS=false

# Restrict to specific site internal names (comma separated). Empty = all sites
# visible to the account.
UNIFI_SITES=

# How often (seconds) to poll the console for fresh live data.
POLL_INTERVAL_SECONDS=30

# Experimental: also subscribe to the controller's WebSocket event stream for
# near-instant client connect/disconnect/roam and AP up/down updates. The poll
# above stays on as the authoritative reconciler. Undocumented UniFi API.
WEBSOCKET_ENABLED=false

# Collect AP floor-plan placement (x,y) live from classic Maps / InnerSpace, so
# an AP move shows up via the API without regenerating the OpenIntent zip.
PLACEMENT_ENABLED=true

# ---------------------------------------------------------------------------
# Meraki-compatible facade
# ---------------------------------------------------------------------------
# The API key a client (e.g. a Hamina Live "Cisco Meraki" integration, or curl)
# must present in X-Cisco-Meraki-API-Key / Authorization: Bearer to read the
# Meraki-shaped endpoints. Generate a long random string.
MERAKI_COMPAT_API_KEY=replace-with-a-long-random-token

# Display name for the synthesized Meraki "organization".
MERAKI_ORG_NAME=UniFi

# ---------------------------------------------------------------------------
# Catalyst Center (DNA Center) compatible facade
# ---------------------------------------------------------------------------
# Hamina's vendor sync against this facade WORKS — APs land on a Hamina Live map
# with real channels, TX power, per-radio client counts and capacity analysis.
# The catch: the connector resolves hardware against Cisco models only, so every
# AP must declare itself Cisco via CATALYST_MODEL_OVERRIDE below. Telemetry is
# genuine; the hardware identity is not, which makes coverage simulation run on
# the wrong antenna pattern — fine for monitoring, misleading for planning.
# See docs/CATALYST.md. The individual client list is still refused.
CATALYST_ENABLED=false
CATALYST_USERNAME=hamina
CATALYST_PASSWORD=change-me
# Record every /dna/* request (matched or not) so you can see exactly what
# Hamina calls. Read it at GET /catalyst/_captured.
CATALYST_LOG_REQUESTS=true

# Force every AP to report this model string.
#
# REQUIRED for the Catalyst sync, and a deliberate trade-off. Hamina's connector
# resolves an AP against Cisco hardware only — a bare Cisco model token, make
# implied by the connector. No UniFi spelling is accepted: not UniFi's code
# (U7PROMAX), not our slug (u7-pro-max), not Hamina's display name (U7 Pro Max),
# not its own catalog id (ubiquiti:u7-pro-max). Only a Cisco token works:
#
#   CATALYST_MODEL_OVERRIDE=CW9166      # every AP reports as a Cisco 9166i
#
# Leave EMPTY unless you accept that every AP is then labelled as hardware you
# do not own, and that Hamina's coverage simulation uses its antenna pattern.
# For live UniFi data without that trade-off, use the browser extension.
CATALYST_MODEL_OVERRIDE=

# ---------------------------------------------------------------------------
# Scheduled OpenIntent refresh (near-live re-import)
# ---------------------------------------------------------------------------
# Enable the background job that re-runs the exporter on an interval.
OPENINTENT_REFRESH_ENABLED=false

# Path to the companion exporter. Baked into the image at a pinned commit, so
# the default works with nothing mounted and nothing cloned. Change it only to
# run against your own checkout (mount it over /opt/exporter, or point here).
OPENINTENT_EXPORTER_PATH=/opt/exporter/unifi_export.py

# Exporter mode and how often to regenerate the zip. Set REFRESH_SECONDS=0 to
# generate the zip once at startup (initial import) and then rely on live AP
# positions from the placement layer instead of periodic full rebuilds.
OPENINTENT_MODE=innerspace
OPENINTENT_REFRESH_SECONDS=900
OPENINTENT_OUTPUT_DIR=./exports

# When a floor plan's structure changes (rescaled, resized, image replaced, or
# a plan added/removed) the exported zip goes stale — AP *moves* do not count.
# Default: flag it on /openintent/status, log a warning, and POST the optional
# webhook below. Set AUTO_REGENERATE=true to instead re-run the exporter
# automatically on such a change.
OPENINTENT_AUTO_REGENERATE=false
OPENINTENT_STALE_WEBHOOK=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
# The port the app listens on INSIDE the container. Leave it alone.
# To move the port on the HOST, set HOST_PORT below: docker-compose
# maps HOST_PORT to the container's 8080, so changing PORT instead
# leaves Docker forwarding to a port nothing is listening on — the
# container starts cleanly, serves nobody, and the healthcheck fails
# it into a restart loop.
PORT=8080

# Host port Docker publishes on. Change this rather than adding `ports:` to a
# compose override — an override appends to a sequence instead of replacing it,
# so you would publish both and collide with whatever already holds 8080.
HOST_PORT=8080

# ---------------------------------------------------------------------------
# Public exposure (optional) — Cloudflare Tunnel
# ---------------------------------------------------------------------------
# To reach the bridge from Hamina's cloud you need a public HTTPS endpoint.
# The `tunnel` docker compose profile runs cloudflared with this token; create
# a tunnel in the Cloudflare Zero Trust dashboard and paste its token here.
# See docs/EXPOSURE.md. Leave empty if you expose it another way.
CF_TUNNEL_TOKEN=

# --- RSSI sensors (WLAN Pi multilateration) ---------------------------------
# OFF by default. This is the ONLY endpoint that accepts data — everything else
# is read-only, and the browser extension promises exactly that. Turning it on
# opens POST /report, so it will not start without a token.
SENSORS_ENABLED=false
# Shared secret the sensors present as X-Sensor-Token. Anyone who can post here
# can put an AP anywhere on your floor plan, indistinguishably from a real
# measurement. Generate one: openssl rand -hex 24
SENSOR_TOKEN=
# Which plan the sensors cover, and where each one sits on it IN PIXELS.
# Build it by clicking the plan at http://<bridge>/sensors.
# IN A CONTAINER THIS PATH IS INSIDE THE IMAGE: ./sensors.json means
# /app/sensors.json, not the file next to your compose file. Mount it:
#   volumes: [ "./sensors.json:/app/sensors.json:ro" ]
# Missing or broken, ingest stays off and /api/located says why — the rest of
# the bridge keeps running.
SENSOR_CONFIG_PATH=./sensors.json
# Path loss. Guesses until calibrated for the site:
#   python3 rssi_sensor.py --calibrate --iface wlan1@36 --dist 5
# An uncalibrated exponent biases every distance the same way, and a
# least-squares fit absorbs that into a confident wrong position.
SENSOR_RSSI_AT_1M=-40.0
SENSOR_PATHLOSS_EXPONENT=3.0
# BLE transmits around 10 dBm where an AP runs ~20, so the same distance reads
# about 10 dB weaker. Sharing the Wi-Fi intercept pushes every BLE fix outward,
# consistently — a bias the residual cannot show you.
SENSOR_BLE_RSSI_AT_1M=-50.0
# The exponent describes the BUILDING, not the radio, so BLE shares the Wi-Fi
# one by default. 0 means exactly that. Set it only if you have measured BLE in
# this building separately.
SENSOR_BLE_PATHLOSS_EXPONENT=0
# Samples older than this do not count toward a fix.
SENSOR_WINDOW_SECONDS=6.0
# Two circles meet at two points; three are needed to choose. Sensors are
# per-channel, so a 6 GHz radio is not heard by a 2.4 GHz interface — three
# sensors must be on the band you want to locate.
SENSOR_MIN_SENSORS=3
# Forget a transmitter unheard this long.
SENSOR_FORGET_SECONDS=300.0

# --- Open5GS (LTE / 5G cells presented as access points) --------------------
# Reads an Open5GS core and folds its cells into the same snapshot the UniFi
# APs are in, so they reach the neutral API, the dashboard, the Meraki facade
# and the Catalyst facade with no new plumbing. A cell is NOT an access point:
# the identity, the attached UEs and the session state are real, the band and
# TX power are what you declare in cells.json, and the Wi-Fi band and channel
# are invented. See docs/OPEN5GS.md before showing anyone a heatmap.
OPEN5GS_ENABLED=false

# Base URL of each network function's metrics server — `metrics.server` in its
# YAML, conventionally port 9090. AMF for 5G, MME for 4G; set either or both.
# In Docker these are container names on the core's compose network.
# Per-cell and per-UE detail needs Open5GS 2.7.7 or newer (the /gnb-info,
# /enb-info and /ue-info dumpers). An older core still gives you a cell with a
# client count, from the /metrics totals.
OPEN5GS_AMF_URL=
OPEN5GS_MME_URL=
# Optional. The SMF is the only NF that knows a UE's IP address and DNN;
# without it clients appear with no address.
OPEN5GS_SMF_URL=
OPEN5GS_TIMEOUT_SECONDS=5.0
OPEN5GS_VERIFY_TLS=true

# What the core cannot know: band, ARFCN, bandwidth, TX power, and where the
# radio sits on a floor plan. Copy cells.example.json and edit.
OPEN5GS_CELLS_PATH=./cells.json

# Which UniFi site the cells belong to — this decides which floor plans they
# can be placed on. Empty = the first site polled, which is what a single-site
# console wants. Set it on a multi-site console.
OPEN5GS_SITE_ID=

# List individual UEs as clients. Off keeps the per-cell counts and publishes
# no subscriber identifiers at all.
OPEN5GS_INCLUDE_UES=true
# An idle UE is registered but has no RRC connection, so no cell is carrying it
# right now. Off by default so a cell's client count matches its radio.
OPEN5GS_INCLUDE_IDLE_UES=false
# A SUPI is an IMSI — it identifies a person's SIM, and this ends up on a
# dashboard that gets screen-shared. Masked shows PLMN + last four.
OPEN5GS_MASK_SUPI=true

# --- Open5G2GO (preferred source when you run it) ---------------------------
# https://github.com/Waveriders-Collective/open5G2GO — a private 4G/5G toolkit
# around Open5GS. Its backend answers strictly more than the core does: the same
# cells and UEs, PLUS the RF read off the radio over SNMP (band, EARFCN,
# bandwidth, TX power, PRB utilisation, real MAC / serial / model / firmware)
# and device names from the subscriber database. Set this and it is used INSTEAD
# of the OPEN5GS_*_URL settings above, and cells.json shrinks to placement plus
# the model costume.
#
# The one thing it cannot report is which cell a UE is on — it tracks a single
# radio, so there is nothing to attribute. With one cell that is exact; with
# several, use the core's own endpoints above, which give an NR-CGI per UE.
OPEN5G2GO_URL=
OPEN5G2GO_API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Wi-Fi HaLow (802.11ah AP presented as an access point)
# ---------------------------------------------------------------------------
# OFF by default. When on, an Alfa (or other OpenWrt/ubus) HaLow radio is read
# every poll and its AP + associated stations join the same snapshot the UniFi
# APs are in, reaching all four surfaces unchanged. A HaLow AP is a real 802.11
# access point — but NOT a 2.4/5/6 GHz one: it runs sub-GHz, and the band and
# channel reported downstream are a stable, out-of-the-way costume. The true
# carrier rides on the radio's carrier_label. See docs/HALOW.md.
HALOW_ENABLED=false
# The radio's web address. https by default (the box serves the UI and the ubus
# bridge on https); a bare host/IP is fine. Reachable from wherever this runs.
HALOW_HOST=
# The radio's local admin. The Alfa MatrixPro default is admin / admin — change
# it on the box and set the new value here.
HALOW_USERNAME=admin
HALOW_PASSWORD=
HALOW_VERIFY_TLS=false
HALOW_TIMEOUT_SECONDS=5.0
# The wireless interface to read (wlan0 on the AHM27292U).
HALOW_DEVICE=wlan0
# Which UniFi site the AP belongs to. Empty = the cellular default (OPEN5GS_SITE_ID,
# then the first site polled), which is what a single-site console wants.
HALOW_SITE_ID=
# Cosmetics. The SSID is the default display name and the board model the
# default model; set these to override either on the map.
HALOW_NAME=
HALOW_MODEL=
# Where the AP sits on a floor plan. Prefer the anchor form: name a UniFi AP
# already placed on the console's own map and the HaLow AP inherits its position
# every poll — nothing to re-import when it moves. The explicit form
# (HALOW_FLOORPLAN + HALOW_X_PX/HALOW_Y_PX) is for a radio with no UniFi AP near it.
HALOW_ANCHOR_AP=
HALOW_DX_PX=0
HALOW_DY_PX=0
HALOW_FLOORPLAN=
HALOW_X_PX=
HALOW_Y_PX=

# ---------------------------------------------------------------------------
# LoRaWAN gateway (MikroTik RouterOS, presented as an access point)
# ---------------------------------------------------------------------------
# OFF by default. When on, a MikroTik LoRa gateway (a wAP LR8 running RouterOS
# 6) is read every poll over the RouterOS binary API and joins the same snapshot
# the UniFi APs are in, reaching all four surfaces unchanged. A LoRa gateway is
# NOT a 2.4/5/6 GHz radio — it is a sub-GHz LoRaWAN packet forwarder — so it
# wears a stable out-of-the-way Wi-Fi costume and its real carrier rides on the
# radio's carrier_label. Only the gateway is drawn: a single gateway's per-packet
# RSSI cannot position its end devices, so none are fabricated. See docs/LORA.md.
LORA_ENABLED=false
# The gateway's address. RouterOS 6 has no REST API, so this speaks the binary
# API on TCP 8728; a bare host/IP is fine. Reachable from wherever this runs.
LORA_HOST=
LORA_PORT=8728
# The box's admin. Change it from the factory default and set the new value here.
LORA_USERNAME=admin
LORA_PASSWORD=
LORA_TIMEOUT_SECONDS=5.0
# Which /lora interface to read, when the box has more than one. Empty = the
# first one printed, which is what a single-gateway box wants.
LORA_INTERFACE=
# Which UniFi site the gateway belongs to. Empty = the cellular/HaLow default
# (OPEN5GS_SITE_ID, then the first site polled).
LORA_SITE_ID=
# Cosmetics. The /lora interface name is the default display name and the
# RouterBOARD model the default model; set these to override either on the map.
LORA_NAME=
LORA_MODEL=
# Where the gateway sits on a floor plan. Prefer the anchor form: name a UniFi
# AP already placed on the console's own map and the gateway inherits its
# position every poll. The explicit form (LORA_FLOORPLAN + LORA_X_PX/LORA_Y_PX)
# is for a gateway with no UniFi AP near it.
LORA_ANCHOR_AP=
LORA_DX_PX=0
LORA_DY_PX=0
LORA_FLOORPLAN=
LORA_X_PX=
LORA_Y_PX=

# --- Cisco Meraki APs (Dashboard API) ---------------------------------------
# Reads a Meraki organization's wireless APs every poll and puts them on the same
# map as the UniFi APs: real channel, width, power, busy time and clients. The
# Hamina panel joins them by the AP's name on the Hamina map. See docs/MERAKI_LIVE.md.
MERAKI_LIVE_ENABLED=false
# Dashboard > My profile > API access. Read-only org access is enough.
MERAKI_LIVE_API_KEY=
# Needed only if the key sees more than one organization.
MERAKI_LIVE_ORG_ID=
# Comma-separated network ids; empty = every network with APs.
MERAKI_LIVE_NETWORK_IDS=
# Which UniFi site the Meraki APs join; empty = the cellular/HaLow/LoRa default.
MERAKI_LIVE_SITE_ID=
# Optional placement on the console's own floor plan, per Meraki AP name:
# "Home-Lab=U7-Pro-Bedroom@30,0; Other=Kitchen" (anchor AP, nudged dx,dy pixels).
MERAKI_LIVE_ANCHORS=
