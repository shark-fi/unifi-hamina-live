{
  "manifest_version": 3,
  "name": "UniFi Live",
  "version": "0.2.0",
  "description": "Live UniFi clients and AP telemetry on the InnerSpace floor plan, and on Hamina's map. Read-only (GETs only).",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "UniFi Live"
  }
}
